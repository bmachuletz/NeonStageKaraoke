#!/bin/sh
set -eu

APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export VLC_PLUGIN_PATH="$APPDIR/usr/lib/vlc/plugins"
# Lokaler Erstwert. Eine gespeicherte Adresse darf ihn überstimmen; bewusst
# gesetzte KARAOKE_SERVER-/NEONSTAGE_SERVER_URL-Werte bleiben vorrangig.
export NEONSTAGE_DEFAULT_SERVER_URL="${NEONSTAGE_DEFAULT_SERVER_URL:-http://127.0.0.1:5274}"

exec "$APPDIR/usr/bin/Karaoke.App.Desktop" "$@"
