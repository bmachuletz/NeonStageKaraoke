# Optional configuration for NeonStage-Server-x86_64.AppImage.
# Copy this file to ~/.local/share/neon-stage/server/server.env and keep it private.

# ASPNETCORE_URLS=http://0.0.0.0:5274
# KARAOKE_LIBRARY_PATH=/home/user/Music/NeonStage
# KARAOKE_DATABASE_PATH=/home/user/.local/share/neon-stage/server/karaoke.db

# Create the Spotify application at https://developer.spotify.com/dashboard.
# Spotify__ClientId=
# Spotify__ClientSecret=
# Spotify__RedirectUri=http://127.0.0.1:5274/api/spotify/callback

# Optional external GPU aligner. Serving and importing complete song packages
# does not require it.
# LRC_ALIGNER_URL=http://127.0.0.1:8081
