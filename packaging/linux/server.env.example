# Optional configuration for NeonStage-Server-x86_64.AppImage.
# Copy this file to ~/.local/share/neon-stage/server/server.env and keep it private.

# ASPNETCORE_URLS=http://0.0.0.0:5274
# KARAOKE_LIBRARY_PATH=/home/user/Music/NeonStage
# KARAOKE_DATABASE_PATH=/home/user/.local/share/neon-stage/server/karaoke.db
# Public HTTP address encoded into guest QR codes.
Karaoke__PublicBaseUrl=http://cloud.hdvtec.de:5274

# Create the Spotify application at https://developer.spotify.com/dashboard.
# Spotify__ClientId=
# Spotify__ClientSecret=
# Spotify__RedirectUri=http://127.0.0.1:5274/api/spotify/callback

# Optional Qobuz partner integration for authorized purchase downloads.
# Never enter a Qobuz account password. Without these environment variables,
# the same settings can be managed from the Lyrics Editor.
# Qobuz__Enabled=false
# Qobuz__AppId=
# Qobuz__AppSecret=
# Qobuz__UserAuthToken=
# Qobuz__FormatId=6
# Qobuz__ApiBaseUrl=https://www.qobuz.com/api.json/0.2

# Optional UltraStar DataBase timing source. Its cache belongs outside the
# application image and may be deleted safely.
# Usdb__Enabled=true
# Usdb__BaseUrl=https://usdb.eu
# Usdb__CachePath=/home/user/.local/share/neon-stage/server/usdb-cache
# Usdb__MaximumDurationDifferenceSeconds=10
# Authenticated usdb.animux.de is preferred; usdb.eu remains the fallback.
# Keep this private file out of source control when credentials are present.
# Usdb__Animux__Enabled=true
# Usdb__Animux__BaseUrl=https://usdb.animux.de
# Usdb__Animux__Username=
# Usdb__Animux__Password=

# Optional external GPU aligner. Serving and importing complete song packages
# does not require it.
# LRC_ALIGNER_URL=http://127.0.0.1:8081
