# Image name and host port for the GPU alignment service.
NEON_STAGE_ALIGNER_IMAGE=neon-stage-aligner:local
LRC_ALIGNER_PORT=8081

# Persistent host directories. They are mounted into the container and must
# never be committed. Models are downloaded lazily when the first job needs them.
LRC_ALIGNER_DATA_PATH=./data
LRC_ALIGNER_MODEL_PATH=./models

# GPU runtime. Use cuda for production alignment; auto/cpu are diagnostic only.
ALIGN_DEVICE=cuda
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Optional CPU Basic-Pitch sidecar and conservative A/B evidence. Inner word
# and syllable candidates remain report-only until explicitly set to select.
BASIC_PITCH_URL=http://basic-pitch:8090
BASIC_PITCH_PORT=8091
BASIC_PITCH_VOCAL_RANGE_MARGIN_SEMITONES=7
BASIC_PITCH_INTERNAL_WORD_MODE=shadow
BASIC_PITCH_SYLLABLE_MODE=shadow
BASIC_PITCH_TIMELINE_MIN_AMPLITUDE=0.25
BASIC_PITCH_TIMELINE_MAX_EVENTS=5000
BASIC_PITCH_WORD_MIN_AMPLITUDE=0.25
BASIC_PITCH_WORD_MAX_ENTRIES=5000
BASIC_PITCH_REPETITION_MIN_SIMILARITY=0.72
LRC_BASIC_PITCH_ENABLED=true
LRC_BASIC_PITCH_DEVICE=cpu
LRC_BASIC_PITCH_USE_FOR_ALIGNMENT=true
LRC_BASIC_PITCH_USE_FOR_SEPARATOR_SCORE=false
BASIC_PITCH_CONTOUR_THRESHOLD=0.20
BASIC_PITCH_CONTOUR_STRIDE=2
BASIC_PITCH_NOTE_CONTOUR_RADIUS_BINS=6
BASIC_PITCH_MAX_CONTOUR_POINTS=30000

# Timing windows and alignment strategy.
LRC_PRE_ROLL=0.45
LRC_POST_ROLL=0.35
LRC_ALIGNMENT_MODE=line-windows
LRC_ALIGNMENT_BATCH_SIZE=1
# Immutable multi-candidate engine: select is the validated production mode;
# shadow only records decisions and off retains the legacy output.
LRC_ENGINE_V2_MODE=select
LRC_ENGINE_V2_MIN_LINE_IMPROVEMENT=0.035
LRC_ENHANCED_INPUT_MIN_IMPROVEMENT=0.06
LRC_ENGINE_V2_SHORT_WINDOW_SECONDS=12
LRC_ENGINE_V2_SHORT_WINDOW_OVERLAP_SECONDS=3
# Reference-guided profile: reliable manual lines calibrate only nearby,
# untouched lines. Large residuals are rejected instead of being propagated.
LRC_EDITOR_GUIDANCE_MAX_DISTANCE=45
LRC_EDITOR_GUIDANCE_MAX_SHIFT=1.5
LRC_ACOUSTIC_SYLLABLE_REFINE=true
LRC_PHONEME_CTC_REFINE=true
LRC_PHONEME_CTC_MODEL=facebook/wav2vec2-xlsr-53-espeak-cv-ft
LRC_GLOBAL_PHONEME_MODE=primary
LRC_GLOBAL_PHONEME_CHUNK_SECONDS=24
LRC_GLOBAL_PHONEME_CONTEXT_SECONDS=1.2
LRC_PHONEME_PROMOTION_MIN_CONFIDENCE=0.50
LRC_PHONEME_PROMOTION_MIN_EVIDENCE=0.60
LRC_PHONEME_PROMOTION_MAX_SHIFT=0.14
LRC_MICRO_BOUNDARY_MODE=select
LRC_MICRO_BOUNDARY_SEARCH_RADIUS=0.055
LRC_MICRO_BOUNDARY_MIN_IMPROVEMENT=0.08

# Independent ASR verification and safe contextual prompts.
LRC_ASR_PROMPT=true
LRC_ASR_MODEL=Qwen/Qwen3-ASR-1.7B-hf
# Existing models run fully offline. Set false after the initial model setup to
# fail immediately if a required model file is genuinely missing.
LRC_ALLOW_MODEL_DOWNLOADS=true
LRC_ASR_PROMPT_MAX_CHARS=1600
LRC_ASR_EXTRA_CONTEXT=

# Stable-TS/Whisper validation. large-v3 is validated sequentially on an 8 GiB
# RTX 4070 Laptop GPU; use turbo and shorter chunks for smaller GPUs.
LRC_STABLE_TS_MODEL=large-v3
LRC_STABLE_TS_CHUNK_SECONDS=30
LRC_STABLE_TS_CHUNK_OVERLAP_SECONDS=3
LRC_STABLE_TS_PROMPT_MAX_CHARS=700

# Independent Analysis and Stage separation. Models are loaded sequentially.
LRC_ANALYSIS_SEPARATOR_ENABLED=true
LRC_ANALYSIS_SEPARATOR_MODELS=model_bs_roformer_ep_317_sdr_12.9755.ckpt,model_mel_band_roformer_ep_3005_sdr_11.4360.ckpt
LRC_STAGE_SEPARATOR_MODEL=mel_band_roformer_karaoke_aufr33_viperx_sdr_10.1956.ckpt
LRC_ORIGINAL_MIX_BLEND_MODE=fallback
LRC_ORIGINAL_MIX_BLEND_RATIO=0.15
LRC_EVIDENCE_FUSION_MODE=shadow
LRC_PYIN_ENABLED=true
LRC_PYIN_REPORT_MAX_POINTS=12000
# Normal songs stay in one complete model pass. Only tracks longer than five
# minutes use bounded, overlapping ASR/alignment windows.
LRC_TRANSCRIPTION_CHUNK_THRESHOLD_SECONDS=300
LRC_TRANSCRIPTION_CHUNK_SECONDS=20
LRC_TRANSCRIPTION_CHUNK_OVERLAP_SECONDS=2
LRC_CANONICAL_TRANSFER_MIN_COVERAGE=0.55
LRC_TRANSCRIPTION_MAX_NEW_TOKENS=256
LRC_TRANSCRIPTION_LINE_GAP=0.9
LRC_TRANSCRIPTION_LINE_WORDS=11
LRC_TRANSCRIPTION_LINE_CHARS=64

# Optional audio candidates. The baseline always remains available as fallback.
LRC_ALIGNMENT_CANDIDATES=true
LRC_ALIGNMENT_CANDIDATE_BLEND=true
LRC_ALIGNMENT_BLEND_RATIOS=0.10
LRC_ALIGNMENT_MIN_IMPROVEMENT=0.01
LRC_ALIGNMENT_WEIGHT_PITCH_QUALITY=0.08
LRC_ALIGNMENT_CANDIDATE_ORIGINAL=false
LRC_ALIGNMENT_KEEP_CANDIDATES=false

# Optional GPU-only duet analysis. The pinned 233 MB CC-BY-4.0 checkpoint is
# downloaded lazily into LRC_ALIGNER_MODEL_PATH. Shadow mode is diagnostic and
# never changes timings or assigns singer lanes automatically.
LRC_MEDLEYVOX_ENABLED=true
LRC_MEDLEYVOX_MODE=promote
LRC_MEDLEYVOX_MAX_WINDOW_SECONDS=12
LRC_MEDLEYVOX_MAX_WINDOWS=12
LRC_MEDLEYVOX_CHUNK_SECONDS=3
LRC_MEDLEYVOX_CHUNK_OVERLAP_SECONDS=1
LRC_MEDLEYVOX_PROMOTION_MIN_SCORE=0.42
LRC_MEDLEYVOX_PROMOTION_MIN_MARGIN=0.08
LRC_MEDLEYVOX_IDENTITY_MIN_MARGIN=0.035
