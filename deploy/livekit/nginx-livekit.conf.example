# WSS/HTTPS signaling only. WebRTC media ports are not HTTP and must be opened
# directly in the host/cloud firewall as documented in README.md.
map $http_upgrade $livekit_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl http2;
    server_name livekit.cloud.hdvtec.de;

    ssl_certificate /etc/letsencrypt/live/livekit.cloud.hdvtec.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/livekit.cloud.hdvtec.de/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $livekit_connection_upgrade;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }
}
