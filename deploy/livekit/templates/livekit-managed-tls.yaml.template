port: 7880
bind_addresses:
  - ""
logging:
  level: info
  json: false
rtc:
  tcp_port: 7881
  # One UDP-mux port is sufficient for the small NeonStage rooms.
  udp_port: 7882
  use_external_ip: true
keys:
  __LIVEKIT_API_KEY__: __LIVEKIT_API_SECRET__
turn:
  enabled: true
  domain: __LIVEKIT_TURN_DOMAIN__
  external_tls: true
  tls_port: 5349
  udp_port: 3478
room:
  empty_timeout: 300
  departure_timeout: 20
