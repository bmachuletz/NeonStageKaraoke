# Host path containing your private karaoke library. It is mounted as /library
# inside the server container and is never copied into the image.
KARAOKE_LIBRARY_PATH=/absolute/path/to/your/karaoke/library

# Persistent host directory for SQLite, Spotify tokens and server settings.
KARAOKE_DATA_PATH=./data

# Public HTTP port and numeric host user/group used for mounted-file access.
NEON_STAGE_PORT=5274
NEON_STAGE_UID=1000
NEON_STAGE_GID=1000

# Create an application in the Spotify Developer Dashboard and register this
# exact redirect URL. Keep the client secret only in the untracked .env file.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5274/api/spotify/callback

# The separately running CUDA aligner is exposed on the Docker host at 8081.
LRC_ALIGNER_URL=http://host.docker.internal:8081

# Local image name. A registry image can be substituted without editing Compose.
NEON_STAGE_SERVER_IMAGE=neon-stage-server:local
