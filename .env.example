# Host path containing your private karaoke library. It is mounted as /library
# inside the server container and is never copied into the image.
KARAOKE_LIBRARY_PATH=/absolute/path/to/your/karaoke/library

# Persistent host directory for SQLite, Spotify tokens and server settings.
KARAOKE_DATA_PATH=./data

# Public HTTP port and numeric host user/group used for mounted-file access.
NEON_STAGE_PORT=5274
# Optional stable guest URL. Leave empty on a native host for automatic LAN-IP
# detection. Set it for Docker, reverse proxies, VPNs or public deployments.
NEON_STAGE_PUBLIC_URL=http://cloud.hdvtec.de:5274
NEON_STAGE_UID=1000
NEON_STAGE_GID=1000

# Optional Spotify Web API integration. Create an application at
# https://developer.spotify.com/dashboard and register this exact Redirect URI.
# Spotify permits HTTP for explicit loopback IPs such as 127.0.0.1, but not for
# localhost. Use your real HTTPS callback when the server is remotely hosted.
# Keep the Client Secret only in the untracked .env file.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5274/api/spotify/callback

# Optional Qobuz partner integration for authorized purchase downloads.
# Request official integration access from Qobuz (api@qobuz.com). Never enter
# a Qobuz account password here. Format IDs: 5=MP3 320, 6=FLAC CD,
# 7=FLAC Hi-Res 96 and 27=FLAC Hi-Res 192.
QOBUZ_ENABLED=false
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=
QOBUZ_USER_AUTH_TOKEN=
QOBUZ_FORMAT_ID=6
QOBUZ_API_BASE_URL=https://www.qobuz.com/api.json/0.2

# Optional UltraStar DataBase timing source. Authenticated usdb.animux.de is
# preferred when both values below are configured; usdb.eu remains the
# automatic fallback. Keep the password only in your untracked .env file.
USDB_ENABLED=true
USDB_BASE_URL=https://usdb.eu
USDB_MAX_DURATION_DIFFERENCE_SECONDS=10
USDB_ANIMUX_ENABLED=true
USDB_ANIMUX_BASE_URL=https://usdb.animux.de
USDB_ANIMUX_USERNAME=
USDB_ANIMUX_PASSWORD=

# The separately running CUDA aligner is exposed on the Docker host at 8081.
LRC_ALIGNER_URL=http://host.docker.internal:8081

# Local image name. A registry image can be substituted without editing Compose.
NEON_STAGE_SERVER_IMAGE=neon-stage-server:local

# Optional self-hosted LiveKit/WebRTC room service. Key and secret stay on the server.
ONLINE_ENABLED=false
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_PREFIX=neonstage-
