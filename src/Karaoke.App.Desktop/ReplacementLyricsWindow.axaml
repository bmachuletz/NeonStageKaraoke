<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Karaoke.App.Desktop.ReplacementLyricsWindow"
        Title="Neue Lyrics beziehen"
        Width="900" Height="650" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#0D1016">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="24">
    <StackPanel>
      <TextBlock Text="NEUE LYRICS BEZIEHEN" Foreground="#DFFF28" FontSize="22" FontWeight="Bold" />
      <TextBlock x:Name="SongLabel" Foreground="#C0C6D2" Margin="0,3,0,0" />
      <TextBlock Text="USDB und LRCLIB werden als übernehmbare Textquellen durchsucht; Genius ergänzt offizielle Trefferlinks. Alternativ erzeugt Volltranskript den Text direkt aus dem Audio. Provider-Lyrics und Volltranskript werden anschließend mit EasyAligner an der Vocalspur ausgerichtet und als neuer Review-Stand gespeichert."
                 Foreground="#8993A6" TextWrapping="Wrap" Margin="0,5,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,18,0,10">
      <TextBox x:Name="QueryBox" Watermark="Titel suchen …" KeyDown="QueryKeyDown" />
      <Button Grid.Column="1" Content="⌕ Alle Quellen durchsuchen" Click="SearchClick" Margin="8,0,0,0" />
    </Grid>

    <TextBlock x:Name="SourcesLabel" Grid.Row="2" Foreground="#45E6D0" FontSize="11"
               FontFamily="monospace" Margin="0,0,0,10" TextWrapping="Wrap" />

    <Border Grid.Row="3" Background="#10151D" BorderBrush="#2A303B" BorderThickness="1" CornerRadius="8">
      <ListBox x:Name="ResultsList" SelectionChanged="ResultSelectionChanged"
               Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,9">
              <Border Background="#263044" CornerRadius="4" Padding="8,4" Margin="0,0,12,0"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding SourceLabel}" Foreground="#DFFF28" FontSize="10" FontWeight="Bold" />
              </Border>
              <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="BESTER TREFFER" Foreground="#FF3CBD" FontSize="10"
                             FontWeight="Bold" IsVisible="{Binding IsRecommended}" />
                  <TextBlock Text="{Binding TimingLabel}" Foreground="#45E6D0" FontSize="10" />
                </StackPanel>
                <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Details}" Foreground="#8993A6" FontSize="11" />
              </StackPanel>
              <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding ScoreLabel}" Foreground="#FF3CBD" FontSize="16"
                           FontWeight="Bold" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding ScoreCaption}" Foreground="#677185" FontSize="9" HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Row="4" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
      <ProgressBar x:Name="Progress" Width="150" IsIndeterminate="True" IsVisible="False"
                   Foreground="#DFFF28" />
      <TextBlock x:Name="StatusLabel" Grid.Column="1" Margin="12,0,0,0" Foreground="#8993A6"
                 TextWrapping="Wrap" VerticalAlignment="Center" />
    </Grid>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,18,0,0">
      <Button Content="Abbrechen" Click="CancelClick" />
      <Button x:Name="OpenSourceButton" Content="Quelle im Browser öffnen" Click="OpenSourceClick"
              IsVisible="False" />
      <Button x:Name="SelectButton" Content="Auswählen und mit EasyAligner ausrichten"
              Click="SelectClick" IsEnabled="False" Background="#DFFF28" Foreground="#11151C" />
    </StackPanel>
  </Grid>
</Window>
